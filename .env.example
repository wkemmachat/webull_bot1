# ---- TH Strategy Bot ----------------------------------------------------
# Copy to .env (run.sh does this the first time). Never commit .env.
# Everything else (LINE, Webull keys, strategies, money) is set in the app.

# Mac: 0 (http://localhost).  Server behind Caddy/HTTPS: 1
COOKIE_SECURE=0

# Only ONE running copy may have the scheduler on (it trades and sends LINE).
# Set 0 on the Mac once the DigitalOcean server is live.
SCHEDULER_ENABLED=1

# The address you open the app at (used in LINE links)
#   Mac:    http://127.0.0.1:8000
#   Server: https://webull-bot1.kemmachat.com
PUBLIC_URL=http://127.0.0.1:8000

# Optional. Long random string; if empty a key is created in data/secret.key.
# It encrypts the stored Webull and LINE secrets - keep a copy with your backups.
SECRET_KEY=

# Your one login. On the Mac you can leave these empty and create it on the first page.
# On a server set them: the create-login page only works on the bot's own computer.
APP_USERNAME=
APP_PASSWORD=

# yahoo = live prices (default) · csv = offline demo files in data/csv
DATA_SOURCE=yahoo

# Server only: the port Docker publishes on 127.0.0.1 (Caddy proxies to it). Pick a free one.
BOT_PORT=8012

# Advanced
# DATA_DIR=./data
# TICK_SECONDS=30
# DISPLAY_TZ=Asia/Bangkok
